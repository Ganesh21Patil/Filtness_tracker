# Phase 2 (save estimate + auth) — copy this file to .env.local and fill in
# real values once you've created a Supabase project. Nothing here is
# required for the site to run today; auth features stay hidden/no-op until
# both of these are set (see lib/supabase/config.ts).

# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Also required, done in the Supabase dashboard (not an env var here):
# Authentication → Providers → Google — enable it and paste in a Google
# Cloud OAuth Client ID + Secret (console.cloud.google.com → APIs & Services
# → Credentials → Create OAuth client ID → Web application). Add
# https://<your-supabase-project>.supabase.co/auth/v1/callback as an
# authorized redirect URI on the Google side.
